<Window x:Class="Restaurant.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thống Kê &amp; Báo Cáo Doanh Thu" Height="720" Width="1050" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F9" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="📈 BÁO CÁO THỐNG KÊ DOANH THU &amp; MÓN ĂN" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="btnHeaderBack" Content="⬅ Quay lại" HorizontalAlignment="Right" Width="100" Height="32" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnBack_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Phần Lọc Ngày -->
        <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="6" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpFromDate" Width="140" Height="30" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="14" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpToDate" Width="140" Height="30" VerticalContentAlignment="Center"/>
                
                <Button x:Name="btnFilter" Content="🔍 Lọc Dữ Liệu" Width="130" Height="32" Margin="20,0,0,0" Click="btnFilter_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Nội dung chính (2 Tabs) -->
        <TabControl x:Name="tabMain" Grid.Row="2" Background="White" BorderBrush="#BDC3C7">
            <!-- Tab 1: Doanh Thu -->
            <TabItem Header="📊 Báo Cáo Doanh Thu" FontSize="14" FontWeight="Bold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bảng Danh Sách Hóa Đơn -->
                    <DataGrid x:Name="dgRevenue" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10" SelectionChanged="dgRevenue_SelectionChanged" Background="White" BorderBrush="#BDC3C7" RowHeight="35" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HĐ" Binding="{Binding OrderId}" Width="70"/>
                            <DataGridTextColumn Header="Bàn" Binding="{Binding Table.TableName}" Width="90"/>
                            <DataGridTextColumn Header="Thu ngân" Binding="{Binding Account.FullName}" Width="130"/>
                            <DataGridTextColumn Header="Giờ vào" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Giờ ra (Thanh toán)" Binding="{Binding CheckoutDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Giảm giá (đ)" Binding="{Binding Discount, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="Thành tiền (đ)" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold" Foreground="#1565C0"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tiêu Đề Chi Tiết Món -->
                    <TextBlock Grid.Row="1" Text="🍽️ CHI TIẾT CÁC MÓN ĐÃ PHỤC VỤ / TÍNH TIỀN CỦA HÓA ĐƠN ĐANG CHỌN:" FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,5,0,5"/>

                    <!-- Bảng Chi Tiết Món Ăn -->
                    <DataGrid x:Name="dgOrderDetails" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Background="#FAFAFA" BorderBrush="#BDC3C7" RowHeight="35" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Chi Tiết" Binding="{Binding DetailId}" Width="90"/>
                            <DataGridTextColumn Header="Tên Món Ăn" Binding="{Binding FoodName}" Width="*"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding Quantity}" Width="90" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Đơn Giá (đ)" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Thành Tiền (đ)" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold" Foreground="#D35400"/>
                            <DataGridTextColumn Header="Trạng Thái Bếp" Binding="{Binding StatusText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tổng Doanh Thu -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="TỔNG DOANH THU KHOẢNG THỜI GIAN:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtTotalRevenue" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Món Ăn Bán Chạy & Doanh Thu Cao Nhất -->
            <TabItem Header="🏆 Thống Kê Món Ăn &amp; Doanh Thu" FontSize="14" FontWeight="Bold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Thẻ Nổi Bật Món Doanh Thu Cao Nhất -->
                    <Border Grid.Row="0" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆 MÓN DOANH THU CAO NHẤT: " FontSize="15" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTopRevenueFood" Text="---" FontSize="16" FontWeight="Bold" Foreground="#D35400" VerticalAlignment="Center" Margin="5,0,20,0"/>
                                <TextBlock Text="Doanh thu mang về: " FontSize="15" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTopRevenueAmount" Text="0 VNĐ" FontSize="16" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tùy Chọn Sắp Xếp -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Sắp xếp theo: " VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cboSortOption" Width="220" Height="30" VerticalContentAlignment="Center" Margin="10,0,0,0" SelectionChanged="cboSortOption_SelectionChanged">
                            <ComboBoxItem Content="Số lượng bán nhiều nhất" IsSelected="True"/>
                            <ComboBoxItem Content="Doanh thu mang về cao nhất"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- DataGrid Món Ăn -->
                    <DataGrid x:Name="dgTopSelling" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" Background="White" BorderBrush="#BDC3C7" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Món" Binding="{Binding FoodId}" Width="100"/>
                            <DataGridTextColumn Header="Tên Món Ăn" Binding="{Binding FoodName}" Width="*"/>
                            <DataGridTextColumn Header="Số Lượng Đã Bán" Binding="{Binding TotalQuantitySold}" Width="150" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tổng Tiền Thu Về (đ)" Binding="{Binding TotalRevenue, StringFormat={}{0:N0}}" Width="200" FontWeight="Bold" Foreground="#27AE60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <!-- Nút Quay lại -->
            <Button x:Name="btnBack" Content="⬅ Quay lại Trang chủ" Width="180" Height="38" HorizontalAlignment="Left" Click="btnBack_Click" Background="#7F8C8D" Foreground="White" FontWeight="Bold"/>
            
            <!-- Xuất Báo Cáo -->
            <Button x:Name="btnExportCsv" Content="📊 Xuất Excel (CSV)" Width="170" Height="38" HorizontalAlignment="Right" Click="btnExportCsv_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
