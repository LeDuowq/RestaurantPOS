<Window x:Class="WPF.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Đăng nhập - Quản Lý Nhà Hàng" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F9">
        <Border Width="380" Padding="35,30" Background="White" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" ShadowDepth="3" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🍽️ NHÀ HÀNG POS" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Đăng nhập hệ thống" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <TextBlock Text="Tên đăng nhập:" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                <TextBox Name="txtUsername" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,15"/>

                <TextBlock Text="Mật khẩu:" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                <PasswordBox Name="txtPassword" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,25"/>

                <Button Name="btnLogin" Content="🔑 ĐĂNG NHẬP" 
                        Height="42" 
                        Background="#27AE60" Foreground="White" 
                        FontSize="15" FontWeight="Bold" 
                        Click="btnLogin_Click" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
