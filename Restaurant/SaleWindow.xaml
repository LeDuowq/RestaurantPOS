<Window x:Class="Restaurant.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant"
        mc:Ignorable="d"
        Title="Sơ Đồ Bàn Ăn &amp; Bán Hàng" Height="580" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F9" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯 SƠ ĐỒ BÀN ĂN &amp; PHỤC VỤ" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,30,0"/>

                    <!-- Chú thích trạng thái bàn -->
                    <Border Width="16" Height="16" Background="#4CAF50" CornerRadius="4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Bàn trống" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <Border Width="16" Height="16" Background="#F44336" CornerRadius="4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Đang có khách" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Name="btnClose" Content="⬅ Quay lại" HorizontalAlignment="Right" Width="100" Height="32" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="icTables">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="150" Height="140" Margin="12" Tag="{Binding}" Click="btnTable_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10" 
                                                        BorderBrush="#DEE2E6" BorderThickness="2">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="🍽️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                        <TextBlock Text="{Binding TableName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                            <Setter Property="Background" Value="#F44336"/>
                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
