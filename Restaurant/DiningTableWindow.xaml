<Window x:Class="Restaurant.DiningTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant"
        mc:Ignorable="d"
        Title="Quản lý Sơ đồ Bàn ăn" Height="520" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F9" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="🍽️ QUẢN LÝ SƠ ĐỒ BÀN ĂN" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="btnBack" Content="⬅ Quay lại" HorizontalAlignment="Right" Width="100" Height="32" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnBack_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Bên trái: DataGrid -->
            <DataGrid x:Name="dgTables" Grid.Column="0" AutoGenerateColumns="False" 
                      SelectionChanged="dgTables_SelectionChanged" IsReadOnly="True" Margin="0,0,10,0"
                      Background="White" BorderBrush="#BDC3C7" RowHeight="35" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Bàn" Binding="{Binding TableId}" Width="80"/>
                    <DataGridTextColumn Header="Tên Bàn" Binding="{Binding TableName}" Width="*"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bên phải: Form nhập liệu -->
            <Border Grid.Column="1" Background="White" Padding="15" CornerRadius="6" BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="THÔNG TIN BÀN ĂN" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Mã bàn:" Margin="0,5,0,5" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtTableId" IsReadOnly="True" Background="#EEEEEE" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Tên bàn (VD: Bàn 1):" Margin="0,5,0,5" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtTableName" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Trạng thái:" Margin="0,5,0,5" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbStatus" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15">
                        <ComboBoxItem Content="Trống" Tag="0"/>
                        <ComboBoxItem Content="Đang có khách" Tag="1"/>
                    </ComboBox>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="btnAdd" Content="Thêm" Width="70" Height="35" Margin="4" Click="btnAdd_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="btnUpdate" Content="Sửa" Width="70" Height="35" Margin="4" Click="btnUpdate_Click" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="btnDelete" Content="Xóa" Width="70" Height="35" Margin="4" Click="btnDelete_Click" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                    </WrapPanel>

                    <Button x:Name="btnClear" Content="Làm mới" Height="35" Margin="4,15,4,0" Click="btnClear_Click" Background="#9E9E9E" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
