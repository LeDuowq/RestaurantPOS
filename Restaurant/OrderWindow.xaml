<Window x:Class="WPF.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="OrderWindow" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F9" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="📝 GỌI MÓN &amp; THANH TOÁN HÓA ĐƠN" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="btnBack" Content="⬅ Quay lại Sơ đồ bàn" HorizontalAlignment="Right" Width="170" Height="32" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnBack_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Hóa đơn của bàn (Chiếm 4.2 phần) -->
                <ColumnDefinition Width="4.2*"/>
                <!-- Cột phải: Danh sách Menu (Chiếm 5.8 phần) -->
                <ColumnDefinition Width="5.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= KHU VỰC BÊN TRÁI: CHI TIẾT HÓA ĐƠN ================= -->
            <Border Grid.Column="0" Background="White" Margin="0,0,5,0" Padding="15" CornerRadius="8" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtTableName" Text="Hóa đơn -  ..." FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Height="29" VerticalAlignment="Bottom"/>

                    <!-- Bảng hiển thị các món khách đã gọi -->
                    <DataGrid x:Name="dgOrderDetails" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="White" BorderBrush="#EEE" BorderThickness="1" RowHeight="35" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên món" Width="*" Binding="{Binding FoodName}"/>
                            <DataGridTextColumn Header="SL" Width="40" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Đơn giá" Width="80" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="Thành tiền" Width="90" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="Trạng thái" Width="95" Binding="{Binding StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Khu vực tổng tiền và thanh toán -->
                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <Separator Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                            <TextBlock Text="Tổng cộng: " FontSize="18" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock x:Name="txtTotalPrice" Text="0 VNĐ" FontSize="18" FontWeight="Bold" Foreground="#E53935"/>
                        </StackPanel>

                        <Button x:Name="btnPayment" Content="💳 THANH TOÁN HÓA ĐƠN" Height="45" Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="btnPayment_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Thông báo dành cho Bồi bàn -->
                        <Border x:Name="borderWaitstaffNotice" Visibility="Collapsed" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                            <TextBlock Text="⚠️ Bồi bàn chỉ có quyền xem danh sách món đã order. Thu ngân mới có quyền order thêm món và thanh toán!" TextWrapping="Wrap" Foreground="#E67E22" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= KHU VỰC BÊN PHẢI: MENU THỰC ĐƠN ================= -->
            <Border Grid.Column="1" Background="White" Margin="5,0,0,0" Padding="15" CornerRadius="8" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text=" ThỰC ĐƠN (MENU)" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                    <!-- COMBOBOX LỌC MÓN ĂN -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Danh mục: " VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#555"/>
                        <ComboBox x:Name="cboCategory" Width="220" Height="32" Margin="10,0,0,0" FontSize="14"
                              DisplayMemberPath="CategoryName" 
                              SelectedValuePath="CategoryId" 
                              SelectionChanged="cboCategory_SelectionChanged"/>
                    </StackPanel>

                    <!-- Danh sách các món ăn để click chọn -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="icMenu">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Nút bấm chứa Ảnh, Tên món và Giá -->
                                    <Button Width="130" Height="175" Margin="5" Tag="{Binding}" Click="btnFoodItem_Click" 
                                            Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                            <Image Source="{Binding Img}" Width="100" Height="65" Stretch="UniformToFill" Margin="0,0,0,4">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,100,65" RadiusX="5" RadiusY="5"/>
                                                </Image.Clip>
                                            </Image>
                                            <TextBlock Text="{Binding FoodName}" TextWrapping="Wrap" TextAlignment="Center" 
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#1565C0"/>

                                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" TextAlignment="Center" 
                                                       FontSize="13" FontWeight="Bold" Foreground="#E53935" Margin="0,2,0,0"/>

                                            <TextBlock Text="{Binding Quantity, StringFormat={}Còn: {0} suất}" TextAlignment="Center" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#27AE60" Margin="0,2,0,0"/>
                                        </StackPanel>

                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>